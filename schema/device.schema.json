{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.amsler-solar.ch/amsler-solar/ModbusSpec/schema/device.schema.json",
  "title": "ModbusSpec device, format version 0",
  "type": "object",
  "required": [
    "modbusspec",
    "id",
    "manufacturer",
    "name",
    "kind",
    "sources",
    "connection",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "modbusspec": {
      "const": 0
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "inverter",
        "battery",
        "meter",
        "charger",
        "heat_pump",
        "heating_rod",
        "boiler",
        "ventilation",
        "hvac",
        "pool",
        "ups",
        "io",
        "energy_manager",
        "other"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pages": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "license": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archive_url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "what"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "default_port",
        "default_unit"
      ],
      "additionalProperties": false,
      "properties": {
        "default_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "default_unit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "transports": {
          "type": "array",
          "items": {
            "enum": [
              "tcp",
              "tls",
              "udp",
              "rtu",
              "ascii",
              "rtu_over_tcp",
              "rtu_over_udp"
            ]
          }
        },
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baud": {
              "type": "integer"
            },
            "format": {
              "type": "string",
              "pattern": "^[78][NEO][12]$"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_registers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 125
            },
            "even_address": {
              "type": "boolean"
            },
            "max_gap": {
              "type": "integer",
              "minimum": 0
            },
            "min_interval_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "input_equals_holding": {
          "type": "boolean"
        },
        "write_multiple": {
          "type": "boolean"
        },
        "write_single": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "table",
              "address",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "table": {
                "$ref": "#/$defs/table"
              },
              "address": {
                "$ref": "#/$defs/address"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 125
              },
              "unit_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "sleeps": {
          "type": "boolean"
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "udp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "rtu_over_tcp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "rtu_over_udp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "reply_prefix": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2})+$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "client_certificate": {
              "enum": [
                "required",
                "optional",
                "none"
              ]
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "min_version": {
              "enum": [
                "1.2",
                "1.3"
              ]
            }
          }
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byte_order": {
          "enum": [
            "big",
            "little",
            "detect"
          ]
        },
        "word_order": {
          "enum": [
            "big",
            "little",
            "detect"
          ]
        },
        "detect": {
          "type": "object",
          "required": [
            "table",
            "address",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "$ref": "#/$defs/table"
            },
            "address": {
              "$ref": "#/$defs/address"
            },
            "type": {
              "$ref": "#/$defs/type"
            },
            "plausible": {
              "$ref": "#/$defs/range"
            },
            "in": {
              "type": "array"
            },
            "equals": {
              "type": [
                "number",
                "string"
              ]
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "unit_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "word_orders": {
              "type": "object",
              "propertyNames": {
                "pattern": "^-?[0-9]+$"
              },
              "additionalProperties": {
                "enum": [
                  "big",
                  "little"
                ]
              },
              "minProperties": 1
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "match": {
            "oneOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/condition"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/condition"
                      },
                      "minItems": 2
                    }
                  ]
                },
                "minItems": 1
              }
            ]
          },
          "match_any": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/condition"
            },
            "minItems": 1
          }
        }
      }
    },
    "identify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serial": {
          "oneOf": [
            {
              "$ref": "#/$defs/register"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "table",
                  "address",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "table": {
                    "$ref": "#/$defs/table"
                  },
                  "address": {
                    "$ref": "#/$defs/address"
                  },
                  "type": {
                    "$ref": "#/$defs/type"
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "chars": {
                    "enum": [
                      "both",
                      "high",
                      "low"
                    ]
                  },
                  "unit_id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "byte_order": {
                    "enum": [
                      "big",
                      "little"
                    ]
                  },
                  "word_order": {
                    "enum": [
                      "big",
                      "little"
                    ]
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                }
              },
              "minItems": 1
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                },
                "minItems": 2
              }
            ]
          }
        },
        "any": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/condition"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/condition"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/condition"
                      },
                      "minItems": 2
                    }
                  ]
                },
                "minItems": 1
              }
            ]
          },
          "minItems": 1
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "patternProperties": {
          "^-?[0-9]+$": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "kind",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "object",
            "required": [
              "key"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "equals": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "not": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "in": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "bit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "prefix": {
                "type": "string"
              },
              "not_in": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            }
          },
          "kind": {
            "enum": [
              "fault",
              "warning",
              "mains_lost",
              "backup_mode"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "patternProperties": {
          "^([0-9]|[1-5][0-9]|6[0-3])$": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^([a-z0-9_]+|x\\.[a-z0-9_.]+)$"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "positive": {
            "enum": [
              "export",
              "import",
              "discharge",
              "charge",
              "consumption",
              "generation"
            ]
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sum": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "factor": {
                  "type": "number"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          },
          "verified": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "factor": {
                  "type": "number"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "sum"
            ]
          },
          {
            "required": [
              "first"
            ]
          }
        ]
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "model_choice": {
      "enum": [
        "auto",
        "user"
      ]
    },
    "sunspec": {
      "type": "boolean"
    },
    "reserved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "table",
          "address"
        ],
        "additionalProperties": false,
        "properties": {
          "table": {
            "$ref": "#/$defs/table"
          },
          "address": {
            "$ref": "#/$defs/address"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "bits": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "minItems": 2,
            "maxItems": 2
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "table": {
      "enum": [
        "holding",
        "input",
        "coil",
        "discrete"
      ]
    },
    "address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "type": {
      "enum": [
        "bool",
        "u16",
        "s16",
        "u32",
        "s32",
        "u64",
        "s64",
        "f16",
        "f32",
        "f64",
        "sm16",
        "sm32",
        "bcd16",
        "bcd32",
        "bcd64",
        "str",
        "datetime"
      ]
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "register": {
      "type": "object",
      "required": [
        "table",
        "address",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "$ref": "#/$defs/table"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "chars": {
          "enum": [
            "both",
            "high",
            "low"
          ]
        },
        "unit_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "byte_order": {
          "enum": [
            "big",
            "little"
          ]
        },
        "word_order": {
          "enum": [
            "big",
            "little"
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "table",
        "address",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "$ref": "#/$defs/table"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "equals": {
          "type": [
            "number",
            "string"
          ]
        },
        "in": {
          "type": "array"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "prefix": {
          "type": "string"
        },
        "printable": {
          "type": "boolean"
        },
        "chars": {
          "enum": [
            "both",
            "high",
            "low"
          ]
        },
        "not": {
          "type": [
            "number",
            "string"
          ]
        },
        "not_in": {
          "type": "array"
        },
        "answers": {
          "type": "boolean"
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "word_order": {
          "enum": [
            "big",
            "little"
          ]
        },
        "byte_order": {
          "enum": [
            "big",
            "little"
          ]
        },
        "unit_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "key",
        "label",
        "table",
        "address",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^([a-z0-9_]+|x\\.[a-z0-9_.]+)$"
        },
        "label": {
          "type": "string"
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "scale_exponent_from": {
          "type": "object",
          "required": [
            "table",
            "address",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "$ref": "#/$defs/table"
            },
            "address": {
              "$ref": "#/$defs/address"
            },
            "type": {
              "$ref": "#/$defs/type"
            },
            "length": {
              "type": "integer",
              "minimum": 1
            },
            "negate": {
              "type": "boolean"
            },
            "bits": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "minItems": 2,
              "maxItems": 2
            },
            "signed": {
              "type": "boolean"
            }
          }
        },
        "positive": {
          "enum": [
            "export",
            "import",
            "discharge",
            "charge",
            "consumption",
            "generation"
          ]
        },
        "enum": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "poll": {
          "enum": [
            "fast",
            "slow"
          ]
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "minItems": 2,
          "maxItems": 2
        },
        "writable": {
          "type": "boolean"
        },
        "write_only": {
          "type": "boolean"
        },
        "write_address": {
          "$ref": "#/$defs/address"
        },
        "write_multiple": {
          "type": "boolean"
        },
        "write_single": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "persistent": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
